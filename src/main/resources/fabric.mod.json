{
  "schemaVersion": 1,
  "id": "replay-to-world",
  "version": "${version}",
  "name": "Replay to World",
  "description": "Converts a ReplayMod .mcpr recording into a playable singleplayer world by extracting every chunk packet from the recording.",
  "authors": ["peli_G", "PearitX2"],
  "contact": {
    "homepage": "https://github.com/peli-G/ReplayMod-Recording-To-World",
    "sources":  "https://github.com/peli-G/ReplayMod-Recording-To-World",
    "issues":   "https://github.com/peli-G/ReplayMod-Recording-To-World/issues"
  },
  "license": "https://github.com/peli-G/ReplayMod-Recording-To-World/blob/main/LICENSE",
  "icon": "assets/replay-to-world/favicon_logo.png",
  "environment": "client",
  "accessWidener": "replay-to-world.accesswidener",
  "entrypoints": {
    "client": [
      "com.pelig.replaytoworld.ReplayToWorldMod"
    ]
  },
  "mixins": [
    "replay-to-world.mixins.json"
  ],
  "depends": {
    "fabricloader": "${depends_loader}",
    "minecraft": "${depends_minecraft}",
    "java": "${depends_java}",
    "fabric-api": "*",
    "replaymod": "*"
  }
}
