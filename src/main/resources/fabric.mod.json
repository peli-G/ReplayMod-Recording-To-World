{
  "schemaVersion": 1,
  "id": "replay-to-world",
  "version": "1.0.0",
  "name": "Replay to World",
  "description": "Converts a ReplayMod .mcpr recording into a playable singleplayer world by extracting every chunk packet from the recording. Use /replaytoworld <filename>",
  "authors": ["peli_G"],
  "contact": {
    "homepage": "https://github.com/peli-G/Replay-Recording-To-World",
    "sources":  "https://github.com/peli-G/Replay-Recording-To-World",
    "issues":   "https://github.com/peli-G/Replay-Recording-To-World/issues"
  },
  "license": "MIT",
  "icon": "assets/replay-to-world/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.pelig.replaytoworld.ReplayToWorldMod"
    ]
  },
  "mixins": [
    "replay-to-world.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.21.10 <1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
